# ─── ClickUp ───────────────────────────────────────────────────────────────
# Personal API token (NOT prefixed with "Bearer"). Find under Settings → Apps.
CLICKUP_API_TOKEN=
# Numeric workspace ID. From URL: app.clickup.com/<TEAM_ID>/v/...
CLICKUP_TEAM_ID=

# ─── Claude (Anthropic) ────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-7

# ─── Pinecone (SOW vector store) ───────────────────────────────────────────
PINECONE_API_KEY=
PINECONE_INDEX=forge-sows
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# ─── Voyage AI (embeddings) ────────────────────────────────────────────────
# Anthropic's recommended embedding provider.
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3-lite

# ─── Slack ─────────────────────────────────────────────────────────────────
# Bot token (xoxb-...). Required scopes: chat:write, channels:read,
# users:read, conversations.history (for tone profile mining).
SLACK_BOT_TOKEN=
# Channel where red-project escalations are drafted.
SLACK_LEADERSHIP_CHANNEL=#leadership
# Channel where PMs receive review-queue messages.
SLACK_PM_REVIEW_CHANNEL=#pm-review

# ─── Gmail (OAuth) ─────────────────────────────────────────────────────────
GMAIL_CREDENTIALS_PATH=./.secrets/gmail_credentials.json
GMAIL_TOKEN_PATH=./.secrets/gmail_token.json

# ─── Behavior ──────────────────────────────────────────────────────────────
# Classification thresholds (days of inactivity).
STUCK_BLOCKER_DAYS=5
UNTOUCHED_DAYS=5
# Cosine similarity below this → task flagged as scope creep.
SCOPE_SIMILARITY_THRESHOLD=0.72
# Pinecone top-K when retrieving SOW evidence per task.
SCOPE_RAG_TOP_K=3
# Timezone for scheduled jobs.
TZ=America/Los_Angeles
# When true, all sends are no-ops; drafts are logged only. DEFAULT TRUE.
DRY_RUN=true
